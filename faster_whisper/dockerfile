# containers/faster_whisper/Dockerfile
FROM stt-benchmark-base

# faster-whisper only needs CTranslate2 — no numpy conflicts
# pydub + ffmpeg added for the chunked notebook's silence-splitting
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*

RUN pip install faster-whisper==1.0.3 pydub

COPY containers/faster_whisper/notebook_faster_whisper.py /app/
COPY containers/faster_whisper/notebook_faster_whisper_chunked.py /app/

CMD ["python", "notebook_faster_whisper.py"]
##docker compose run --rm faster_whisper python notebook_faster_whisper_chunked.py