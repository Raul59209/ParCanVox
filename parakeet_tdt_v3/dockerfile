# containers/parakeet_tdt_v3/Dockerfile
FROM stt-benchmark-base

RUN pip install "numpy<2.0" --force-reinstall

RUN pip install "pytorch-lightning==2.4.0" "lightning==2.4.0"

RUN pip install "torchmetrics<1.4.0" --force-reinstall

RUN pip uninstall -y apex triton || true

# Lock torch/torchaudio/torchvision at base image versions before NeMo install
RUN pip install "torch==2.7.0" --force-reinstall && \
    pip install "torchaudio==2.7.0" --force-reinstall && \
    pip install "torchvision==0.22.0" --force-reinstall

# Install NeMo without letting it touch torch
RUN pip install --default-timeout=300 --retries 5 --no-deps \
    "nemo_toolkit[asr]" \
    --extra-index-url https://pypi.nvidia.com

# Install NeMo's other dependencies manually
RUN pip install soundfile scipy pandas omegaconf hydra-core \
    "pytorch-lightning==2.4.0" "lightning==2.4.0" \
    "torchmetrics<1.4.0" webdataset braceexpand \
    inflect unidecode text-unidecode

# Re-pin everything — no external index URLs needed, already installed above
RUN pip install "numpy<2.0" --force-reinstall && \
    pip install "pytorch-lightning==2.4.0" "lightning==2.4.0" --force-reinstall && \
    pip install "torchmetrics<1.4.0" --force-reinstall && \
    pip install "torch==2.7.0" "torchaudio==2.7.0" "torchvision==0.22.0" --force-reinstall && \
    pip uninstall -y apex triton || true

COPY containers/parakeet_tdt_v3/notebook_parakeet_tdt_v3.py /app/

CMD ["python", "notebook_parakeet_tdt_v3.py"]