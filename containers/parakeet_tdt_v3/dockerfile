# containers/parakeet_tdt_v3/Dockerfile
FROM stt-benchmark-base

# The core problem this Dockerfile solves:
# NeMo's dependency resolver (via pytorch-lightning) will upgrade torch
# from 2.7.0+cu128 to the latest (2.12.1+cu130 at time of writing).
# That breaks torchaudio since there's no cu130 build for it.
# Fix: install NeMo with torch pinned to stay at the base image version,
# in a single RUN so the constraint is always enforced.

# Remove broken training-only libs before anything else
RUN pip uninstall -y apex triton 2>/dev/null || true

# Install NeMo while pinning torch to the base image version.
# "torch==2.7.0" acts as an upper bound — pip will not upgrade it.
# --extra-index-url https://pypi.nvidia.com is needed for some NeMo sub-deps.
RUN pip install --default-timeout=300 --retries 5 \
    "nemo_toolkit[asr]" \
    "torch==2.7.0" \
    "pytorch-lightning<2.5.0" \
    "lightning<2.5.0" \
    "torchmetrics<1.4.0" \
    "numpy<2.0" \
    soundfile scipy pandas \
    --extra-index-url https://pypi.nvidia.com

# Verify torch hasn't been upgraded before the next layer runs
RUN python -c "import torch; v=torch.__version__; assert '2.7' in v, f'torch was upgraded to {v}'; print(f'torch version OK: {v}')"

COPY containers/parakeet_tdt_v3/notebook_parakeet_tdt_v3.py /app/

CMD ["python", "notebook_parakeet_tdt_v3.py"]